# Keep real values only in the Vercel project environment, never in Git.
#
# The app never talks to the VPS job service directly. It talks to the private
# report gateway, which owns the job service bearer token. The gateway is
# published through Tailscale Funnel on the Oracle VPS.

# Public HTTPS endpoint of the report gateway (Tailscale Funnel).
ESK_GATEWAY_URL=

# Shared secret the app presents as `x-report-token`. Generated once with
# `python shared/gateway/server.py --init` on the VPS.
ESK_GATEWAY_TOKEN=
